# ==============================================================================
# Open Home Inventory - Environment Configuration
# Copy this file to .env and adjust variables for your local setup.
# ==============================================================================

# Vision & Multimodal LLM Backend
# Supported providers: 'ollama', 'vllm', 'openai', 'custom'
VISION_BACKEND=ollama
VISION_ENDPOINT=http://localhost:11434
VISION_MODEL=minicpm-v:latest

# Fallback / Orchestration LLM (Optional)
# Leave empty to use local vision model exclusively
ORCHESTRATOR_ENDPOINT=http://localhost:11434
ORCHESTRATOR_MODEL=qwen2.5:7b

# Email Receipt Scraping Provider
# Supported: 'gog' (gog CLI for Gmail), 'imap', 'mock'
RECEIPT_SCRAPER_PROVIDER=mock
RECEIPT_ACCOUNT_EMAIL=user@example.com
GOG_KEYRING_PASSWORD=your_secure_password

# IMAP Configuration (Only required if RECEIPT_SCRAPER_PROVIDER=imap)
IMAP_SERVER=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=user@example.com
IMAP_PASSWORD=your_app_specific_password

# Cloud Storage & Synchronization (Optional)
DRIVE_SYNC_ENABLED=false
DRIVE_PARENT_FOLDER_ID=

# Storage Paths
DATA_DIR=./data
REPORTS_DIR=./reports
CROPS_DIR=./data/optical_crops

# Web Dashboard
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
